# Copy to deploy/.env with mode 600. Generate independent secrets outside Git/chat.
VILAZUNI_DOMAIN=condominio.example.com
APP_ORIGIN=https://condominio.example.com
DB_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DB_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
# Percent-encode reserved characters in the database password.
DATABASE_URL=postgresql://vilazuni_app:REPLACE_WITH_DIFFERENT_RANDOM_SECRET@database:5432/vilazuni
BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_INSTALLATION_CODE
# Encryption key also used by integrations: retain even with MFA disabled.
# 32 random bytes encoded as 64 hexadecimal characters. Keep outside backups of data.
MFA_SECRET_KEY=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
MFA_ENABLED=false
REQUIRE_MANAGER_MFA=false
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MAIL_FROM=
MAIL_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:responsavel@example.com
# ACCESS_PORTAO_PRINCIPAL_URL=https://your-approved-adapter.example/pulse
# ACCESS_PORTAO_PRINCIPAL_SECRET=
# ACCESS_PORTAO_PRINCIPAL_EVENT_SECRET=

ANDROID_SHA256_CERT_FINGERPRINTS=

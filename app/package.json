{
  "name": "vilazuni",
  "version": "0.7.6",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:import-json": "node scripts/import-json.mjs",
    "backup": "node scripts/backup.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "format": "prettier --ignore-path ../.prettierignore --write \"**/*.{mjs,js,css}\" \"../deploy/**/*.mjs\"",
    "format:check": "prettier --ignore-path ../.prettierignore --check \"**/*.{mjs,js,css}\" \"../deploy/**/*.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "8.23.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "prettier": "3.3.3"
  }
}
